# ──────────────────────────────────────────────────────────────
#  CVeed environment variables
#  Copy this file to ".env.local" and fill in the real values.
#  NEVER commit .env.local to git (it is already in .gitignore).
# ──────────────────────────────────────────────────────────────

# 1. SUPABASE — from your Supabase project:
#    Dashboard → Project Settings → Data API  (URL + anon key)
#    Dashboard → Project Settings → API Keys  (service_role key — KEEP SECRET)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 2. OPENAI — from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# 3. (optional) Models — defaults are fine to leave as-is
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_SCREENING_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
